# Copy to .env and fill in. Only PIXIV_REFRESH_TOKEN is strictly required.

# --- pixiv ------------------------------------------------------------------
# Your own pixiv account's OAuth refresh token (see README "Getting a refresh token").
PIXIV_REFRESH_TOKEN=
# Language for pixiv's tag translations (used for tags Danbooru has no match for)
#PIXIV_LANGUAGE=en-us
# Seconds between pixiv API calls. pixiv rate-limits; don't go much lower.
#PIXIV_MIN_INTERVAL=1.0
# exact_match_for_tags (default) or partial_match_for_tags
#PIXIV_SEARCH_TARGET=exact_match_for_tags
# What an empty search shows: follow (your followed artists) | recommended | ranking | new
#EMPTY_QUERY_SOURCE=follow
# all = one Danbooru post per page of multi-page works; first = only page 1
#PAGES_MODE=all
# pixiv result pages (30 works each) scanned per request when local filters drop results
#MAX_SCAN_PAGES=10
#HIDE_AI=false

# --- Danbooru (tag mapping source) -----------------------------------------
# Optional: your Danbooru account, for higher API limits during sync.
#DANBOORU_LOGIN=
#DANBOORU_API_KEY=
#DANBOORU_MIN_INTERVAL=1.0
#DANBOORU_LIVE_LOOKUPS=true
#SYNC_ON_START=true
#SYNC_INTERVAL_HOURS=24
# Pin the pixiv tag searched for a Danbooru tag (JSON)
#PIXIV_TAG_OVERRIDES={"black_hair": "黒髪", "gloves": "手袋"}
# translated (pixiv's English translation) | original (Japanese) | drop
#UNMAPPED_TAG_STYLE=translated

# --- Bridge -----------------------------------------------------------------
# Strongly recommended: the bridge acts as YOUR pixiv account.
BRIDGE_LOGIN=pixiv
BRIDGE_API_KEY=
#BRIDGE_PUBLIC_URL=https://pixiv-booru.example.com
#ALLOW_WRITES=true
#DEFAULT_LIMIT=20
#MAX_LIMIT=200
#SEARCH_CACHE_TTL=600
#LOG_LEVEL=INFO
#TZ=UTC
